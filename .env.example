# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ── Database (PostgreSQL / Supabase) ──────────────────
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/apni_dukaan?schema=public"
# Direct or session-pooler connection for Prisma migrations (not transaction pooler).
DIRECT_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/apni_dukaan?schema=public"

# ── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-which-edkmjfdnj-feknjfnjfnjnj  
ADMIN_SESSION_HOURS=12
CUSTOMER_SESSION_DAYS=30
# Set true when served over HTTPS (required in production)
COOKIE_SECURE=false

# ── OTP ─────────────────────────────────────────────────
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# When true (never in production) the OTP is also returned in the API response for easy testing
OTP_DEV_ECHO=true

# ── Email (OTP codes are sent by email via Nodemailer) ─
# Leave SMTP_HOST empty in development to print emails to the API console instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-character App Password from https://myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Apni Dukaan <no-reply@apnidukaan.example>"

# ── Seed ────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
